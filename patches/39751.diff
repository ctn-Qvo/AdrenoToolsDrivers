+   .signal_many = vk_kgsl_timeline_signal_many,
+   .get_value = vk_kgsl_timeline_get_value,
+   .wait_many = vk_kgsl_timeline_wait_many,
+};
+
+struct vk_kgsl_binary_timeline {
+   uint32_t id;
+   uint64_t next_point;
+};
+
+struct vk_kgsl_sync_file {
