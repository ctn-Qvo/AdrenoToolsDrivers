+};
+
+static void
+vk_kgsl_binary_close_sync_file(struct vk_kgsl_binary *binary)
+{
+   if (binary->sync_file.fd >= 0) {
+      close(binary->sync_file.fd);
+      binary->sync_file.fd = -1;
+   }
+}
+
+static VkResult
+vk_kgsl_binary_init(struct vk_device *_device,
+                    struct vk_sync *sync,
+                    uint64_t initial_value)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   memset(binary, 0, sizeof(*binary));
+   binary->type = VK_KGSL_SYNC_TYPE_BINARY;
+   binary->sync_file.fd = -1;
+   binary->binary_timeline.next_point = initial_value + 1;
+
+   int ret = kgsl_timeline_create_ioctl(device->physical_device->local_fd,
+                                        initial_value, &binary->binary_timeline.id);
+   if (ret) {
+      binary->binary_timeline.id = 0;
+      return vk_errorf(_device, VK_ERROR_INITIALIZATION_FAILED,
+                       "kgsl_timeline_create failed: %s", strerror(errno));
+   }
+   return VK_SUCCESS;
+}
+
+static void
+vk_kgsl_binary_finish(struct vk_device *_device,
+                      struct vk_sync *sync)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   vk_kgsl_binary_close_sync_file(binary);
+   if (binary->binary_timeline.id != 0) {
+      kgsl_timeline_destroy_ioctl(device->physical_device->local_fd,
+                                  binary->binary_timeline.id);
+      binary->binary_timeline.id = 0;
+   }
+   binary->type = VK_KGSL_SYNC_TYPE_INVALID;
+}
+
+static VkResult
+vk_kgsl_binary_reset(struct vk_device *_device,
+                     struct vk_sync *sync)
+{
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   vk_kgsl_binary_close_sync_file(binary);
+   binary->type = VK_KGSL_SYNC_TYPE_BINARY;
+   binary->binary_timeline.next_point++;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_kgsl_binary_signal(struct vk_device *_device,
+                      struct vk_sync *sync,
+                      uint64_t value)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   if (binary->type != VK_KGSL_SYNC_TYPE_BINARY)
+      return vk_errorf(_device, VK_ERROR_VALIDATION_FAILED,
+                       "attempted to signal imported sync-file");
+   if (value != 0)
+      return vk_errorf(_device, VK_ERROR_VALIDATION_FAILED,
+                       "KGSL binary sync requires signal value 0");
+
+   struct kgsl_timeline_val timeline_val = {
+      .seqno = binary->binary_timeline.next_point,
+      .timeline = binary->binary_timeline.id,
+   };
+
+   int ret = kgsl_timeline_signal_ioctl(device->physical_device->local_fd,
+                                        &timeline_val, 1);
+   if (ret) {
+      return vk_errorf(_device, VK_ERROR_UNKNOWN,
+                       "kgsl_timeline_signal failed: %s", strerror(errno));
+   }
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_kgsl_binary_wait_many(struct vk_device *_device,
+                         uint32_t wait_count,
+                         const struct vk_sync_wait *waits,
+                         enum vk_sync_wait_flags wait_flags,
+                         uint64_t abs_timeout_ns)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+
+   if (wait_count == 0)
+      return VK_SUCCESS;
+
+   /* Count how many timeline waits and fence waits */
+   uint32_t timeline_count = 0, fence_count = 0;
+   bool has_fence = false;
+   for (uint32_t i = 0; i < wait_count; ++i) {
+      struct vk_kgsl_binary *binary = container_of(waits[i].sync, struct vk_kgsl_binary, vk);
+      if (binary->type == VK_KGSL_SYNC_TYPE_BINARY)
+         timeline_count++;
+      else if (binary->type == VK_KGSL_SYNC_TYPE_FENCE) {
+         fence_count++;
+         has_fence = true;
+      } else {
+         return vk_errorf(_device, VK_ERROR_DEVICE_LOST,
+                          "invalid KGSL binary sync state");
+      }
+   }
+
+   /* If we have both timeline and fence waits, we need to poll them together
+    * to properly honor WAIT_ANY. Use poll() on all timeline fds plus fence fds.
+    */
+   if (timeline_count > 0 && fence_count == 0) {
+      /* Pure timeline wait: use KGSL timeline wait */
+      STACK_ARRAY(struct kgsl_timeline_val, timeline_vals, timeline_count);
+      uint32_t idx = 0;
+      for (uint32_t i = 0; i < wait_count; ++i) {
+         struct vk_kgsl_binary *binary = container_of(waits[i].sync, struct vk_kgsl_binary, vk);
+         if (binary->type == VK_KGSL_SYNC_TYPE_BINARY) {
+            timeline_vals[idx++] = (struct kgsl_timeline_val) {
+               .seqno = binary->binary_timeline.next_point,
+               .timeline = binary->binary_timeline.id,
+            };
+         }
+      }
+      uint32_t flag = (wait_flags & VK_SYNC_WAIT_ANY) ? KGSL_TIMELINE_WAIT_ANY : KGSL_TIMELINE_WAIT_ALL;
+      for (;;) {
+         int64_t timeout = get_relative_ns(abs_timeout_ns);
+         int ret = kgsl_timeline_wait_ioctl(device->physical_device->local_fd,
+                                            timeout, timeline_vals, timeline_count, flag);
+         if (!ret) {
+            STACK_ARRAY_FINISH(timeline_vals);
+            return VK_SUCCESS;
+         }
+         if (errno == EINTR) {
+            if (timeout == 0) {
+               STACK_ARRAY_FINISH(timeline_vals);
+               return VK_TIMEOUT;
+            }
+            continue;
+         }
+         if (errno == EBUSY || errno == ETIMEDOUT) {
+            STACK_ARRAY_FINISH(timeline_vals);
+            return VK_TIMEOUT;
+         }
+         STACK_ARRAY_FINISH(timeline_vals);
+         return vk_errorf(_device, VK_ERROR_UNKNOWN,
+                          "kgsl_timeline_wait failed: %s", strerror(errno));
+      }
+   }
+
+   /* Mixed timeline + fence, or pure fence: use poll() on fds */
+   uint32_t total_fds = timeline_count + fence_count;
+   STACK_ARRAY(struct pollfd, pollfds, total_fds);
+   STACK_ARRAY(struct kgsl_timeline_val, timeline_vals, timeline_count);
+   uint32_t timeline_idx = 0;
+   uint32_t poll_idx = 0;
+
+   for (uint32_t i = 0; i < wait_count; ++i) {
+      struct vk_kgsl_binary *binary = container_of(waits[i].sync, struct vk_kgsl_binary, vk);
+      if (binary->type == VK_KGSL_SYNC_TYPE_BINARY) {
+         /* Need to convert timeline to pollable fd */
+         int fd;
+         int ret = kgsl_timeline_fence_get_ioctl(device->physical_device->local_fd,
+                                                  binary->binary_timeline.id,
+                                                  binary->binary_timeline.next_point,
+                                                  &fd);
+         if (ret) {
+            STACK_ARRAY_FINISH(pollfds);
+            STACK_ARRAY_FINISH(timeline_vals);
+            return vk_errorf(_device, VK_ERROR_UNKNOWN,
+                             "failed to get timeline fence fd: %s", strerror(errno));
+         }
+         pollfds[poll_idx].fd = fd;
+         pollfds[poll_idx].events = POLLIN;
+         pollfds[poll_idx].revents = 0;
+         timeline_vals[timeline_idx++] = (struct kgsl_timeline_val) {
+            .seqno = binary->binary_timeline.next_point,
+            .timeline = binary->binary_timeline.id,
+         };
+         poll_idx++;
+      } else if (binary->type == VK_KGSL_SYNC_TYPE_FENCE) {
+         if (binary->sync_file.fd < 0) {
+            STACK_ARRAY_FINISH(pollfds);
+            STACK_ARRAY_FINISH(timeline_vals);
+            return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                             "imported sync-file has invalid fd");
+         }
+         pollfds[poll_idx].fd = binary->sync_file.fd;
+         pollfds[poll_idx].events = POLLIN;
+         pollfds[poll_idx].revents = 0;
+         poll_idx++;
+      }
+   }
+
+   bool any = wait_flags & VK_SYNC_WAIT_ANY;
+   int timeout_ms = get_relative_ms(abs_timeout_ns);
+
+   for (;;) {
+      int ret = poll(pollfds, total_fds, timeout_ms);
+      if (ret < 0) {
+         if (errno == EINTR) {
+            timeout_ms = get_relative_ms(abs_timeout_ns);
+            if (timeout_ms == 0) {
+               STACK_ARRAY_FINISH(pollfds);
+               STACK_ARRAY_FINISH(timeline_vals);
+               return VK_TIMEOUT;
+            }
+            continue;
+         }
+         STACK_ARRAY_FINISH(pollfds);
+         STACK_ARRAY_FINISH(timeline_vals);
+         return vk_errorf(_device, VK_ERROR_UNKNOWN,
+                          "poll failed: %s", strerror(errno));
+      }
+      if (ret == 0) {
+         STACK_ARRAY_FINISH(pollfds);
+         STACK_ARRAY_FINISH(timeline_vals);
+         return VK_TIMEOUT;
+      }
+      if (any) {
+         for (uint32_t i = 0; i < total_fds; ++i) {
+            if (pollfds[i].revents & POLLIN) {
+               /* Close any temporary fds we created */
+               for (uint32_t j = 0; j < total_fds; ++j) {
+                  if (j < timeline_count)
+                     close(pollfds[j].fd);
+               }
+               STACK_ARRAY_FINISH(pollfds);
+               STACK_ARRAY_FINISH(timeline_vals);
+               return VK_SUCCESS;
+            }
+         }
+      } else {
+         bool all_ready = true;
+         for (uint32_t i = 0; i < total_fds; ++i) {
+            if (!(pollfds[i].revents & POLLIN)) {
+               all_ready = false;
+               break;
+            }
+         }
+         if (all_ready) {
+            for (uint32_t j = 0; j < total_fds; ++j) {
+               if (j < timeline_count)
+                  close(pollfds[j].fd);
+            }
+            STACK_ARRAY_FINISH(pollfds);
+            STACK_ARRAY_FINISH(timeline_vals);
+            return VK_SUCCESS;
+         }
+      }
+      timeout_ms = get_relative_ms(abs_timeout_ns);
+      if (timeout_ms == 0) {
+         for (uint32_t j = 0; j < total_fds; ++j) {
+            if (j < timeline_count)
+               close(pollfds[j].fd);
+         }
+         STACK_ARRAY_FINISH(pollfds);
+         STACK_ARRAY_FINISH(timeline_vals);
+         return VK_TIMEOUT;
+      }
+   }
+}
