+static VkResult
+vk_kgsl_binary_import_sync_file(struct vk_device *_device,
+                                struct vk_sync *sync,
+                                int fd)
+{
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   if (fd < 0)
+      return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "invalid sync_file fd");
+
+   int dup_fd = os_dupfd_cloexec(fd);
+   if (dup_fd < 0) {
+      return vk_errorf(_device, VK_ERROR_OUT_OF_HOST_MEMORY,
+                       "failed to duplicate sync_file fd: %s", strerror(errno));
+   }
+
+   vk_kgsl_binary_close_sync_file(binary);
+   binary->sync_file.fd = dup_fd;
+   binary->type = VK_KGSL_SYNC_TYPE_FENCE;
+   return VK_SUCCESS;
+}
+
+static VkResult
+vk_kgsl_binary_export_sync_file(struct vk_device *_device,
+                                struct vk_sync *sync,
+                                int *pFd)
+{
+   struct tu_device *device = container_of(_device, struct tu_device, vk);
+   struct vk_kgsl_binary *binary = container_of(sync, struct vk_kgsl_binary, vk);
+
+   if (!pFd)
+      return VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   *pFd = -1;
+
+   if (binary->type == VK_KGSL_SYNC_TYPE_FENCE) {
+      if (binary->sync_file.fd < 0)
+         return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                          "invalid imported sync_file");
+      int fd = os_dupfd_cloexec(binary->sync_file.fd);
+      if (fd < 0) {
+         return vk_errorf(_device, VK_ERROR_OUT_OF_HOST_MEMORY,
+                          "failed to duplicate sync_file fd: %s", strerror(errno));
+      }
+      *pFd = fd;
+      return VK_SUCCESS;
+   }
+
+   if (binary->type != VK_KGSL_SYNC_TYPE_BINARY)
+      return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "invalid KGSL binary sync state");
+
+   int fd;
+   int ret = kgsl_timeline_fence_get_ioctl(device->physical_device->local_fd,
+                                           binary->binary_timeline.id,
+                                           binary->binary_timeline.next_point,
+                                           &fd);
+   if (ret) {
+      return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "kgsl_timeline_fence_get failed: %s", strerror(errno));
+   }
+   if (fd < 0)
+      return vk_errorf(_device, VK_ERROR_INVALID_EXTERNAL_HANDLE,
+                       "KGSL returned invalid sync_file fd");
+   *pFd = fd;
+   return VK_SUCCESS;
+}
